# Cross-platform line ending normalization
# All text files are stored as LF in the repository
* text=auto eol=lf

# Explicitly mark text files
*.py    text eol=lf
*.sql   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.csv   text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.sh    text eol=lf

# Do not perform line ending normalization on binary files
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.zip   binary
*.gz    binary
*.duckdb binary
